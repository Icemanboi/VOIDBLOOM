{
  "name": "voidbloom",
  "productName": "VOIDBLOOM",
  "version": "1.0.10",
  "description": "A bullet-heaven in a garden at the bottom of the dark.",
  "author": "Isaac Leung",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "test": "xvfb-run -a node test/smoke.js",
    "test:win": "node test/smoke.js",
    "dist:mac": "electron-builder --mac --publish never",
    "test:mac": "node test/smoke.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.isaacleung.voidbloom",
    "productName": "VOIDBLOOM",
    "copyright": "Copyright (c) 2026 Isaac Leung",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "game/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!test/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VOIDBLOOM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VOIDBLOOM",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Icemanboi",
        "repo": "VOIDBLOOM"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.action-games",
      "darkModeSupport": true,
      "artifactName": "VOIDBLOOM-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "VOIDBLOOM ${version}",
      "artifactName": "VOIDBLOOM-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 420,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
